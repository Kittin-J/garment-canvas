#!/bin/zsh
set -euo pipefail

APP_ROOT="${GARMENT_CANVAS_HOME:-$HOME/Applications/GarmentCanvas}"
SUPPORT_DIR="$HOME/Library/Application Support/GarmentCanvas"
ENV_FILE="$SUPPORT_DIR/config/service.env"
LABEL="${GARMENT_CANVAS_LABEL:-com.garmentcanvas.server}"
PLIST_PATH="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
POSTGRES_CONTAINER="${GARMENT_CANVAS_POSTGRES_CONTAINER:-garment-canvas-postgres}"
POSTGRES_VOLUME="${GARMENT_CANVAS_POSTGRES_VOLUME:-garment-canvas-postgres-data}"
POSTGRES_IMAGE="postgres:18-alpine"

read_env() {
  local key="$1" fallback="$2" line value
  line="$(/usr/bin/grep -E "^${key}=" "$ENV_FILE" 2>/dev/null | /usr/bin/head -n 1 || true)"
  value="${line#*=}"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  [[ -n "$value" ]] && print -r -- "$value" || print -r -- "$fallback"
}

read_port() {
  local line value
  line="$(/usr/bin/grep -E '^PORT=' "$ENV_FILE" 2>/dev/null | /usr/bin/head -n 1 || true)"
  value="${line#*=}"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  [[ "$value" == <-> ]] && print -r -- "$value" || print -r -- "3001"
}

if [[ ! -f "$ENV_FILE" ]]; then
  print -u2 "Missing configuration: $ENV_FILE"
  print -u2 "Run install.command first."
  exit 1
fi

if [[ ! -e "$APP_ROOT/current" ]] || [[ ! -f "$APP_ROOT/current/dist-server/index.js" ]]; then
  print -u2 "No active Garment Canvas release. Run install.command first."
  exit 1
fi

if [[ ! -f "$PLIST_PATH" ]]; then
  print -u2 "LaunchAgent is missing: $PLIST_PATH"
  print -u2 "Run install.command first."
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  print -u2 "Docker Desktop is required for the built-in PostgreSQL database."
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  print -u2 "Docker is not running. Start Docker Desktop first."
  exit 1
fi

if /usr/bin/awk '
  /^[[:space:]]*#/ { next }
  /sk-your-apiyi-key/ { found=1 }
  END { exit found ? 0 : 1 }
' "$ENV_FILE"; then
  print -u2 "Edit the gateway placeholders first:"
  print -u2 "  open -e '$ENV_FILE'"
  exit 1
fi

PGDATABASE="$(read_env POSTGRES_DB garment_canvas)"
PGUSER="$(read_env POSTGRES_USER garment_canvas)"
PGPASSWORD="$(read_env POSTGRES_PASSWORD '')"
PGPORT="$(read_env POSTGRES_HOST_PORT 54329)"
if [[ -z "$PGPASSWORD" ]] || [[ "$PGPASSWORD" == replace-* ]]; then
  print -u2 "PostgreSQL password is not configured in: $ENV_FILE"
  exit 1
fi
if [[ "$PGPORT" != <-> ]]; then
  print -u2 "POSTGRES_HOST_PORT must be a number in: $ENV_FILE"
  exit 1
fi

if docker container inspect "$POSTGRES_CONTAINER" >/dev/null 2>&1; then
  OWNER_LABEL="$(docker container inspect -f '{{ index .Config.Labels "com.garmentcanvas.component" }}' "$POSTGRES_CONTAINER" 2>/dev/null || true)"
  if [[ "$OWNER_LABEL" != "postgres" ]]; then
    print -u2 "Container name is already used by another service: $POSTGRES_CONTAINER"
    exit 1
  fi
  EXISTING_IMAGE="$(docker container inspect -f '{{.Config.Image}}' "$POSTGRES_CONTAINER")"
  if [[ "$EXISTING_IMAGE" != "$POSTGRES_IMAGE" ]]; then
    print -u2 "PostgreSQL container uses $EXISTING_IMAGE; PostgreSQL 18 migration is required before startup."
    exit 1
  fi
  docker start "$POSTGRES_CONTAINER" >/dev/null
else
  docker run -d \
    --name "$POSTGRES_CONTAINER" \
    --label com.garmentcanvas.component=postgres \
    --restart unless-stopped \
    -e "POSTGRES_DB=$PGDATABASE" \
    -e "POSTGRES_USER=$PGUSER" \
    -e "POSTGRES_PASSWORD=$PGPASSWORD" \
    -p "127.0.0.1:$PGPORT:5432" \
    -v "$POSTGRES_VOLUME:/var/lib/postgresql" \
    "$POSTGRES_IMAGE" >/dev/null
fi

for _ in {1..60}; do
  if docker exec "$POSTGRES_CONTAINER" pg_isready -U "$PGUSER" -d "$PGDATABASE" >/dev/null 2>&1; then
    break
  fi
  /bin/sleep 1
done
if ! docker exec "$POSTGRES_CONTAINER" pg_isready -U "$PGUSER" -d "$PGDATABASE" >/dev/null 2>&1; then
  print -u2 "PostgreSQL did not become ready. Check: docker logs $POSTGRES_CONTAINER"
  exit 1
fi

/bin/launchctl enable "$DOMAIN/$LABEL" 2>/dev/null || true
if /bin/launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
  /bin/launchctl kickstart -k "$DOMAIN/$LABEL"
else
  /bin/launchctl bootstrap "$DOMAIN" "$PLIST_PATH"
  /bin/launchctl kickstart -k "$DOMAIN/$LABEL"
fi

PORT="$(read_port)"
for _ in {1..30}; do
  if /usr/bin/curl -fsS --max-time 2 "http://127.0.0.1:$PORT/api/ready" >/dev/null 2>&1; then
    print "Garment Canvas is ready: http://127.0.0.1:$PORT/"
    exit 0
  fi
  /bin/sleep 1
done

print -u2 "Service did not become ready. Check:"
print -u2 "  $HOME/Library/Logs/GarmentCanvas/server-error.log"
exit 1
