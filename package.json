{
  "name": "garment-canvas",
  "private": true,
  "version": "0.1.0",
  "description": "Garment design collaboration SaaS - infinite canvas + node workflow (P0 MVP)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "start": "NODE_ENV=production node dist-server/index.js",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run test",
    "test": "tsx tests/dag.test.ts && tsx tests/workflow-schema.test.ts && tsx tests/provider-contract.test.ts && tsx tests/exact-generation.test.ts && tsx tests/auth-storage.test.ts && tsx tests/recent-results.test.ts && tsx tests/project-tabs-session.test.ts && tsx tests/project-tabs.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.1.0",
    "zundo": "^2.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
