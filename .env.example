# change2pro 中转站配置
CHANGE2PRO_BASE_URL=https://your-change2pro-host/v1
CHANGE2PRO_API_KEY=sk-your-key

# 独立图片分组（当前同样按 GPT Image 2 / OpenAI Images 契约调用）
NANOBANANA_MODEL=gpt-image-2
# 中转站按平台分组发 Key 时单独配置；缺省回退 CHANGE2PRO_API_KEY
# NANOBANANA_API_KEY=sk-your-image-group-key
# 网关能力必须按实际接口声明；不支持 n 时系统会循环补足用户选择数量
NANOBANANA_SUPPORTS_N=false
NANOBANANA_MAX_BATCH=1
NANOBANANA_SUPPORTS_MULTI_REFERENCE=true
NANOBANANA_MAX_REFERENCE_IMAGES=8

# gpt-image-2（图改图）
IMAGE2_MODEL=gpt-image-2
IMAGE2_SUPPORTS_N=false
IMAGE2_MAX_BATCH=1
IMAGE2_SUPPORTS_MULTI_REFERENCE=true
IMAGE2_MAX_REFERENCE_IMAGES=8

# 服务端口
PORT=3001

# 数据目录（项目/上传文件）
DATA_DIR=./data

# Docker 内置 PostgreSQL 18（密码必须放在私有 .env，不要提交）
POSTGRES_DB=garment_canvas
POSTGRES_USER=garment_canvas
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 仅暴露给本机开发服务，Docker 内的应用仍直连 5432
POSTGRES_HOST_PORT=54329
# 连接池上限（可选）
DATABASE_POOL_SIZE=10

# 首次启动管理员（仅数据库还没有用户时使用；密码首次登录后必须修改）
INITIAL_ADMIN_ACCOUNT_ID=replace-with-admin-account
INITIAL_ADMIN_PASSWORD=replace-with-temporary-password

# 升级时要导入的旧 SQLite 文件（相对于 DATA_DIR）
# PostgreSQL 为空时只读导入一次，原文件保留不变
SQLITE_IMPORT_FILE=garment-canvas.db

# 内网 HTTP 部署保持 false；启用 HTTPS 反向代理后改为 true
COOKIE_SECURE=false

# 仅启动 API、不托管 dist 前端（完整部署保持 false）
API_ONLY=false

# AI 调用超时（毫秒，中转站网关限制可配，默认 300000）
# AI_TIMEOUT_MS=300000

# 失败重试次数（不含首次，4xx 不重试，默认 2）
# AI_MAX_RETRIES=2
