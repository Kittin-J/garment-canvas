{
  "worktree": {
    "baseRef": "head",
    "symlinkDirectories": ["node_modules"]
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn install:*)",
      "Bash(bun install:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|Read|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-linked-worktree.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
